JWT_SECRET=change-me-to-a-random-string-of-32-plus-chars
JWT_EXPIRY_HOURS=8
COOKIE_SECURE=false
DATABASE_URL=sqlite:///./app.db
STORAGE_DIR=./storage
FRONTEND_ORIGIN=http://localhost:5173
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=
LLM_CHAT_MODEL=
LLM_IMAGE_MODEL=
LLM_IMAGE_SIZE=1024x1536
LLM_IMAGE_QUALITY=medium
# "images" uses /images/edits. "responses" uses /responses + image_generation tool (needed for Codex via OmniRoute)
LLM_IMAGE_EDIT_API=images
LLM_IMAGE_EDIT_MODEL=
# paste the old sketch back outside edited regions (needs storage/models/face_parser.onnx)
EDIT_LOCALIZE=1
# 3D head worker (head3d/README in head3d/server.py); empty = off
HEAD3D_URL=
# Blender figure worker (blender_worker/server.py); empty = off
FIGURE_URL=
AI_MOCK=1
